+fn rewrite_optional_reference(value: &mut Option<String>, old_name: &str, new_name: &str) {
+    if let Some(value) = value {
+        *value = rewrite_sheet_references(value, old_name, new_name);
+    }
+}
+
+fn rewrite_data_reference(reference: &mut DataReference, old_name: &str, new_name: &str) {
+    if let DataReference::Formula(formula) = reference {
+        *formula = rewrite_sheet_references(formula, old_name, new_name);
+    }
+}
+
+fn rewrite_data_series(series: &mut DataSeries, old_name: &str, new_name: &str) {
+    rewrite_data_reference(&mut series.values, old_name, new_name);
+    if let Some(categories) = &mut series.categories {
+        rewrite_data_reference(categories, old_name, new_name);
+    }
+    rewrite_optional_reference(&mut series.name, old_name, new_name);
+    if let Some(error_bars) = &mut series.error_bars {
+        if let Some(plus) = &mut error_bars.plus {
+            rewrite_data_reference(plus, old_name, new_name);
+        }
+        if let Some(minus) = &mut error_bars.minus {
+            rewrite_data_reference(minus, old_name, new_name);
+        }
+    }
+}
+
+fn rewrite_chart_references(chart: &mut Chart, old_name: &str, new_name: &str) {
+    for series in &mut chart.series {
+        rewrite_data_series(series, old_name, new_name);
+    }
+    for group in &mut chart.type_groups {
+        for series in &mut group.series {
+            rewrite_data_series(series, old_name, new_name);
+        }
+    }
+}
+
+fn rewrite_chart_ex_references(chart: &mut ChartEx, old_name: &str, new_name: &str) {
+    for data in &mut chart.data {
+        for dimension in &mut data.dimensions {
+            match dimension {
+                ChartExDimension::String {
+                    formula,
+                    nf_formula,
+                    ..
+                }
+                | ChartExDimension::Numeric {
+                    formula,
+                    nf_formula,
+                    ..
+                } => {
+                    rewrite_optional_reference(formula, old_name, new_name);
+                    rewrite_optional_reference(nf_formula, old_name, new_name);
+                }
+            }
+        }
+    }
+    for series in &mut chart.plot_area.series {
+        if let Some(text) = &mut series.text {
+            if let Some(data) = &mut text.data {
+                rewrite_optional_reference(&mut data.formula, old_name, new_name);
+            }
+        }
+    }
+    for axis in &mut chart.plot_area.axes {
+        if let Some(title) = &mut axis.title {
+            if let Some(text) = &mut title.text {
+                if let Some(data) = &mut text.data {
+                    rewrite_optional_reference(&mut data.formula, old_name, new_name);
+                }
+            }
+        }
+        if let Some(units) = &mut axis.units {
+            if let Some(label) = &mut units.label {
+                if let Some(text) = &mut label.text {
+                    if let Some(data) = &mut text.data {
+                        rewrite_optional_reference(&mut data.formula, old_name, new_name);
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn rewrite_control_references(kind: &mut FormControlKind, old_name: &str, new_name: &str) {
+    match kind {
+        FormControlKind::Checkbox { cell_link, .. }
+        | FormControlKind::OptionButton { cell_link, .. }
+        | FormControlKind::Scrollbar { cell_link, .. }
+        | FormControlKind::Spinner { cell_link, .. } => {
+            rewrite_optional_reference(cell_link, old_name, new_name);
+        }
+        FormControlKind::ListBox {
+            input_range,
+            cell_link,
+            ..
+        }
+        | FormControlKind::Dropdown {
+            input_range,
+            cell_link,
+            ..
+        } => {
+            rewrite_optional_reference(input_range, old_name, new_name);
+            rewrite_optional_reference(cell_link, old_name, new_name);
+        }
+        _ => {}
+    }
+}
+
+fn rewrite_drawing_references(kind: &mut DrawingKind, old_name: &str, new_name: &str) {
+    match kind {
+        DrawingKind::Chart(chart) => rewrite_chart_references(chart, old_name, new_name),
+        DrawingKind::ChartEx(chart) => rewrite_chart_ex_references(chart, old_name, new_name),
+        DrawingKind::FormControl(control) => {
+            rewrite_control_references(&mut control.kind, old_name, new_name)
+        }
+        DrawingKind::Group(group) => {
+            for child in &mut group.children {
+                rewrite_drawing_references(&mut child.kind, old_name, new_name);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn rewrite_validation_references(
+    validation_type: &mut ValidationType,
+    old_name: &str,
+    new_name: &str,
+) {
+    match validation_type {
+        ValidationType::Whole { value1, value2, .. }
+        | ValidationType::Decimal { value1, value2, .. }
