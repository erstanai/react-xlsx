+    /// Keep sheet-scoped names attached to the same worksheet when that
+    /// worksheet moves within the workbook.
+    pub(crate) fn move_sheet_scope(&mut self, from: usize, to: usize) {
+        if from == to {
+            return;
+        }
+
+        let mut rebuilt = HashMap::with_capacity(self.ranges.len());
+        let mut rebuilt_order = Vec::with_capacity(self.order.len());
+        for key in &self.order {
+            let Some(mut range) = self.ranges.remove(key) else {
+                continue;
+            };
+            if let NameScope::Sheet(index) = &mut range.scope {
+                *index = moved_index(*index, from, to);
+            }
+            let next_key = Self::make_key(&range.name, &range.scope);
+            rebuilt_order.push(next_key.clone());
+            rebuilt.insert(next_key, range);
+        }
+        self.ranges = rebuilt;
+        self.order = rebuilt_order;
+    }
