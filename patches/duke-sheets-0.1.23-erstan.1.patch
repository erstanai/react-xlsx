+                rewrite_optional_reference(&mut max_value.value, old_name, new_name);
+            }
+        }
+        CfRuleType::IconSet { values, .. } => {
+            for value in values {
+                if value.value_type == CfValueType::Formula {
+                    rewrite_optional_reference(&mut value.value, old_name, new_name);
+                }
+            }
+        }
+        _ => {}
+    }
