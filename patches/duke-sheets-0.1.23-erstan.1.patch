+#[test]
+fn test_move_worksheet_round_trips_logical_order_with_chartsheet_slot_fixed() {
+    use duke_sheets::SheetSlot;
+    use duke_sheets_chart::{Chart, ChartType};
+
+    let mut wb = Workbook::new();
+    wb.rename_worksheet(0, "One").unwrap();
+    wb.add_worksheet_with_name("Two").unwrap();
+    wb.add_chartsheet(duke_sheets_core::ChartSheet {
+        name: "Chart".to_string(),
+        chart: Chart::new(ChartType::Line),
+        visibility: duke_sheets_core::SheetVisibility::Visible,
+        raw_drawing_objects: Vec::new(),
+        raw_drawing_rels: Vec::new(),
+    })
+    .unwrap();
+    wb.add_worksheet_with_name("Three").unwrap();
+    *wb.sheet_order_mut() = vec![
+        SheetSlot::Worksheet(0),
+        SheetSlot::ChartSheet(0),
+        SheetSlot::Worksheet(1),
+        SheetSlot::Worksheet(2),
+    ];
+
+    // Reopen first to exercise the explicit order emitted by the reader.
+    let mut initial = Vec::new();
+    XlsxWriter::write(&wb, Cursor::new(&mut initial)).unwrap();
+    let mut loaded = XlsxReader::read(Cursor::new(&initial)).unwrap();
+    loaded.move_worksheet(0, 2).unwrap();
+
+    let mut moved = Vec::new();
+    XlsxWriter::write(&loaded, Cursor::new(&mut moved)).unwrap();
+    let reopened = XlsxReader::read(Cursor::new(&moved)).unwrap();
+    assert_eq!(reopened.worksheet(0).unwrap().name(), "Two");
+    assert_eq!(reopened.worksheet(1).unwrap().name(), "Three");
+    assert_eq!(reopened.worksheet(2).unwrap().name(), "One");
+    assert_eq!(
+        reopened.sheet_order(),
+        &[
+            SheetSlot::Worksheet(0),
+            SheetSlot::ChartSheet(0),
+            SheetSlot::Worksheet(1),
+            SheetSlot::Worksheet(2),
+        ]
+    );
+}
