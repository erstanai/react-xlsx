+#[test]
+fn test_rename_worksheet_rewrites_local_references_and_round_trips() {
+    use duke_sheets_core::named_range::NameScope;
+    use duke_sheets_core::Hyperlink;
+
+    let mut wb = Workbook::new();
+    wb.rename_worksheet(0, "Data").unwrap();
+    wb.add_worksheet_with_name("Summary").unwrap();
+    wb.worksheet_mut(0)
+        .unwrap()
+        .set_cell_value("A1", 41.0)
+        .unwrap();
+    wb.worksheet_mut(1)
+        .unwrap()
+        .set_cell_formula(
+            "A1",
+            "=Data!A1+\"Data!A1\"+[Book.xlsx]Start:Data!A1",
+        )
+        .unwrap();
+    wb.define_name("SourceValue", "=Data!$A$1").unwrap();
+    wb.worksheet_mut(1)
+        .unwrap()
+        .set_hyperlink(
+            "B1",
+            Hyperlink {
+                target: "#Data!A1".to_string(),
+                display: None,
+                tooltip: None,
+                location: Some("Data!A1".to_string()),
+            },
+        )
+        .unwrap();
+    wb.worksheet_mut(1)
+        .unwrap()
+        .set_hyperlink(
+            "C1",
+            Hyperlink {
+                target: "Data!Report.xlsx".to_string(),
+                display: None,
+                tooltip: None,
+                location: None,
+            },
+        )
+        .unwrap();
+
+    wb.rename_worksheet(0, "Owner's Data").unwrap();
+    assert_eq!(
+        formula_text_at(wb.worksheet(1).unwrap(), "A1"),
+        Some("='Owner''s Data'!A1+\"Data!A1\"+[Book.xlsx]Start:Data!A1")
+    );
+
+    let mut bytes = Vec::new();
+    XlsxWriter::write(&wb, Cursor::new(&mut bytes)).unwrap();
+    let reopened = XlsxReader::read(Cursor::new(&bytes)).unwrap();
+
+    assert_eq!(reopened.worksheet(0).unwrap().name(), "Owner's Data");
+    assert_eq!(
+        formula_text_at(reopened.worksheet(1).unwrap(), "A1"),
+        Some("='Owner''s Data'!A1+\"Data!A1\"+[Book.xlsx]Start:Data!A1")
+    );
+    assert_eq!(
+        reopened
+            .named_ranges()
+            .get_exact("SourceValue", &NameScope::Workbook)
+            .unwrap()
+            .refers_to,
+        "='Owner''s Data'!$A$1"
+    );
+    let internal = reopened.worksheet(1).unwrap().hyperlink("B1").unwrap();
+    assert_eq!(internal.target, "#'Owner''s Data'!A1");
+    assert_eq!(internal.location.as_deref(), Some("'Owner''s Data'!A1"));
+    assert_eq!(
+        reopened.worksheet(1).unwrap().hyperlink("C1").unwrap().target,
+        "Data!Report.xlsx"
+    );
+}
