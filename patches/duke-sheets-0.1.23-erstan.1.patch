+#[wasm_bindgen_test]
+fn test_workbook_rename_sheet_validates_and_round_trips() {
+    let wb = Workbook::new();
+    wb.add_sheet("Data").unwrap();
+    wb.get_sheet(1)
+        .unwrap()
+        .set_cell("A1", JsValue::from_f64(41.0))
+        .unwrap();
+    wb.get_sheet(0)
+        .unwrap()
+        .set_formula("A1", "=Data!A1+1")
+        .unwrap();
+
+    wb.rename_sheet(1, "Quarterly Data").unwrap();
+    assert_eq!(wb.sheet_names().unwrap(), vec!["Sheet1", "Quarterly Data"]);
+    assert_eq!(
+        wb.get_sheet(0).unwrap().get_formula_at(0, 0).unwrap(),
+        Some("='Quarterly Data'!A1+1".to_string())
+    );
+    wb.calculate(None).unwrap();
+    assert_eq!(
+        wb.get_sheet(0)
+            .unwrap()
+            .get_calculated_value("A1")
+            .unwrap()
+            .as_number(),
+        Some(42.0)
+    );
+    assert!(wb.rename_sheet(1, "sheet1").is_err());
+    assert!(wb.rename_sheet(99, "Missing").is_err());
+
+    let bytes = wb.save_xlsx_bytes().unwrap();
+    let reopened = Workbook::from_bytes(&bytes).unwrap();
+    assert_eq!(
+        reopened.sheet_names().unwrap(),
+        vec!["Sheet1", "Quarterly Data"]
+    );
+    assert_eq!(
+        reopened.get_sheet(0).unwrap().get_formula_at(0, 0).unwrap(),
+        Some("='Quarterly Data'!A1+1".to_string())
+    );
+}
+
+#[wasm_bindgen_test]
+fn test_workbook_move_sheet_updates_active_and_serialized_order() {
+    let wb = Workbook::new();
+    wb.add_sheet("Data").unwrap();
+    wb.add_sheet("Summary").unwrap();
+
+    // Reopen once so the workbook has the explicit sheet_order emitted by an
+    // XLSX reader. This catches moves that only reorder the backing vector but
+    // accidentally preserve the old serialized tab order.
+    let bytes = wb.save_xlsx_bytes().unwrap();
+    let reopened = Workbook::from_bytes(&bytes).unwrap();
+    reopened.move_sheet(0, 2).unwrap();
+    assert_eq!(reopened.active_sheet().unwrap(), 2);
+    assert_eq!(
+        reopened.sheet_names().unwrap(),
+        vec!["Data", "Summary", "Sheet1"]
+    );
+    assert!(reopened.move_sheet(9, 0).is_err());
+
+    let moved_bytes = reopened.save_xlsx_bytes().unwrap();
+    let round_tripped = Workbook::from_bytes(&moved_bytes).unwrap();
+    assert_eq!(
+        round_tripped.sheet_names().unwrap(),
+        vec!["Data", "Summary", "Sheet1"]
+    );
+}
