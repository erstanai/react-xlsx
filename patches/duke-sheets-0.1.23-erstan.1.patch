diff --git a/crates/duke-sheets-core/src/sheet_reference.rs b/crates/duke-sheets-core/src/sheet_reference.rs
new file mode 100644
index 0000000000000000000000000000000000000000..840d0d3599261834753ca05257f7c88759b583e2
--- /dev/null
+++ b/crates/duke-sheets-core/src/sheet_reference.rs
@@ -0,0 +1,260 @@
+//! Rewriting of local worksheet qualifiers in formula/reference text.
+
+/// Rewrite references to `old_name` so they point at `new_name`.
+///
+/// The scanner deliberately preserves all formula text except the matching
+/// worksheet qualifier. It understands quoted worksheet names (including
+/// doubled apostrophes), ignores Excel string literals, handles both ends of a
+/// 3-D reference, and does not rewrite external workbook references.
+pub(crate) fn rewrite_sheet_references(input: &str, old_name: &str, new_name: &str) -> String {
+    if old_name == new_name || input.is_empty() {
+        return input.to_string();
+    }
+
+    let replacement = format!("'{}'", new_name.replace('\'', "''"));
+    let mut output = String::with_capacity(input.len() + replacement.len());
+    let mut index = 0;
+    let mut in_string = false;
+
+    while index < input.len() {
+        let remaining = &input[index..];
+        let Some(ch) = remaining.chars().next() else {
+            break;
+        };
+
+        if ch == '"' {
+            output.push(ch);
+            index += ch.len_utf8();
+            if in_string && input[index..].starts_with('"') {
+                output.push('"');
+                index += 1;
+            } else {
+                in_string = !in_string;
+            }
+            continue;
+        }
+
+        if in_string {
+            output.push(ch);
+            index += ch.len_utf8();
+            continue;
+        }
+
+        if ch == '\'' {
+            if let Some((end, decoded)) = scan_quoted_name(input, index) {
+                let followed_by_qualifier = input[end..]
+                    .chars()
+                    .next()
+                    .is_some_and(|next| next == '!' || next == ':');
+                if followed_by_qualifier && !is_external_reference_prefix(input, index) {
+                    if let Some(rewritten) = rewrite_quoted_qualifier(&decoded, old_name, new_name)
+                    {
+                        output.push_str(&rewritten);
+                        index = end;
+                        continue;
+                    }
+                }
+            }
+        } else if is_reference_boundary_before(input, index) {
+            if let Some(end) = matching_unquoted_name_end(input, index, old_name) {
+                let followed_by_qualifier = input[end..]
+                    .chars()
+                    .next()
+                    .is_some_and(|next| next == '!' || next == ':');
+                if followed_by_qualifier && !is_external_reference_prefix(input, index) {
+                    output.push_str(&replacement);
+                    index = end;
+                    continue;
+                }
+            }
+        }
+
+        output.push(ch);
+        index += ch.len_utf8();
+    }
+
+    output
+}
+
+fn scan_quoted_name(input: &str, start: usize) -> Option<(usize, String)> {
+    let mut decoded = String::new();
+    let mut index = start + 1;
+    while index < input.len() {
+        let ch = input[index..].chars().next()?;
+        if ch == '\'' {
+            let next_index = index + 1;
+            if input[next_index..].starts_with('\'') {
+                decoded.push('\'');
+                index = next_index + 1;
+                continue;
+            }
+            return Some((next_index, decoded));
+        }
+        decoded.push(ch);
+        index += ch.len_utf8();
+    }
+    None
+}
+
+fn matching_unquoted_name_end(input: &str, start: usize, old_name: &str) -> Option<usize> {
+    let mut input_chars = input[start..].char_indices();
+    let mut end = start;
+    for old_char in old_name.chars() {
+        let (offset, input_char) = input_chars.next()?;
+        if !chars_equal_ignore_ascii_case(input_char, old_char) {
+            return None;
+        }
+        end = start + offset + input_char.len_utf8();
+    }
+    Some(end)
+}
+
+fn rewrite_quoted_qualifier(decoded: &str, old_name: &str, new_name: &str) -> Option<String> {
+    // Excel commonly quotes an entire external or 3-D qualifier, for example
+    // '[Book.xlsx]January:March'!A1 and 'January:March'!A1. Never touch the
+    // former; for the latter, sheet names cannot themselves contain a colon,
+    // so its two endpoints are unambiguous.
+    if decoded.contains('[') && decoded.contains(']') {
+        return None;
+    }
+
+    let mut changed = false;
+    let rewritten = if let Some((start, end)) = decoded.split_once(':') {
+        let start = if strings_equal_case_insensitive(start, old_name) {
+            changed = true;
+            new_name
+        } else {
+            start
+        };
+        let end = if strings_equal_case_insensitive(end, old_name) {
+            changed = true;
+            new_name
+        } else {
+            end
+        };
+        format!("{start}:{end}")
+    } else if strings_equal_case_insensitive(decoded, old_name) {
+        changed = true;
+        new_name.to_string()
+    } else {
+        decoded.to_string()
+    };
+
+    changed.then(|| format!("'{}'", rewritten.replace('\'', "''")))
+}
+
+fn chars_equal_ignore_ascii_case(left: char, right: char) -> bool {
+    left == right || left.to_lowercase().eq(right.to_lowercase())
+}
+
+fn strings_equal_case_insensitive(left: &str, right: &str) -> bool {
+    left == right || left.to_lowercase() == right.to_lowercase()
+}
+
+fn is_reference_boundary_before(input: &str, index: usize) -> bool {
+    input[..index].chars().next_back().is_none_or(|previous| {
+        !previous.is_alphanumeric() && previous != '_' && previous != '.' && previous != '#'
+    })
+}
+
+fn is_external_reference_prefix(input: &str, index: usize) -> bool {
+    let prefix = &input[..index];
+    if prefix.chars().next_back() == Some(']') {
+        return true;
+    }
+
+    // Also guard the second endpoint of an unquoted external 3-D qualifier:
+    // `[Book.xlsx]Start:Data!A1`. Looking back from `Data`, a closing bracket
+    // followed only by sheet-name/3-D qualifier characters belongs to the same
+    // qualifier. Operators break that association (`Table[Col]+Data!A1`).
+    let Some(close) = prefix.rfind(']') else {
+        return false;
+    };
+    if prefix[..close].rfind('[').is_none() {
+        return false;
+    }
+    prefix[close + 1..]
+        .chars()
+        .all(|ch| ch.is_alphanumeric() || matches!(ch, '_' | '.' | ':'))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::rewrite_sheet_references;
+
+    #[test]
+    fn rewrites_local_quoted_unquoted_and_3d_references() {
+        assert_eq!(
+            rewrite_sheet_references(
+                "=Data!A1+'Data'!B1+Data:Sheet3!C1+Sheet1:Data!D1",
+                "Data",
+                "Source Data"
+            ),
+            "='Source Data'!A1+'Source Data'!B1+'Source Data':Sheet3!C1+Sheet1:'Source Data'!D1"
+        );
+        assert_eq!(
+            rewrite_sheet_references(
+                "='Old Name:Sheet3'!A1+'Sheet1:Old Name'!B1",
+                "Old Name",
+                "Source Data"
+            ),
+            "='Source Data:Sheet3'!A1+'Sheet1:Source Data'!B1"
+        );
+    }
+
+    #[test]
+    fn preserves_strings_external_references_and_longer_names() {
+        assert_eq!(
+            rewrite_sheet_references(
+                "=\"Data!A1\"+[Book.xlsx]Data!A1+Metadata!A1+DATA!A1",
+                "Data",
+                "Source"
+            ),
+            "=\"Data!A1\"+[Book.xlsx]Data!A1+Metadata!A1+'Source'!A1"
+        );
+        assert_eq!(
+            rewrite_sheet_references(
+                "=[Book.xlsx]Start:Data!A1+'[Book.xlsx]Start:Data'!B1+Data!C1",
+                "Data",
+                "Source"
+            ),
+            "=[Book.xlsx]Start:Data!A1+'[Book.xlsx]Start:Data'!B1+'Source'!C1"
+        );
+        assert_eq!(
+            rewrite_sheet_references(
+                "='C:\\dir\\[Book.xlsx]Data'!A1+Table[Col] Data!B1",
+                "Data",
+                "Source"
+            ),
+            "='C:\\dir\\[Book.xlsx]Data'!A1+Table[Col] 'Source'!B1"
+        );
+    }
+
+    #[test]
+    fn matches_non_ascii_sheet_names_case_insensitively() {
+        assert_eq!(
+            rewrite_sheet_references("=ÜBERSICHT!A1", "Übersicht", "Résumé"),
+            "='Résumé'!A1"
+        );
+    }
+
+    #[test]
+    fn escapes_apostrophes_in_the_new_name() {
+        assert_eq!(
+            rewrite_sheet_references("='Old Name'!A1", "Old Name", "Owner's Data"),
+            "='Owner''s Data'!A1"
+        );
+    }
+
+    #[test]
+    fn preserves_formula_error_tokens_that_look_like_sheet_names() {
+        assert_eq!(
+            rewrite_sheet_references("=#REF!+REF!A1", "REF", "Source"),
+            "=#REF!+'Source'!A1"
+        );
+        assert_eq!(
+            rewrite_sheet_references("=#VALUE!+VALUE!A1", "VALUE", "Source"),
+            "=#VALUE!+'Source'!A1"
+        );
+    }
+}
