+fn moved_index(index: usize, from: usize, to: usize) -> usize {
+    if index == from {
+        return to;
+    }
+    if from < to && index > from && index <= to {
+        return index - 1;
+    }
+    if from > to && index >= to && index < from {
+        return index + 1;
+    }
+    index
+}
