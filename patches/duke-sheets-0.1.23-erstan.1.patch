+        }
+        CfRuleType::DataBar {
+            min_value,
+            max_value,
+            ..
+        } => {
+            if min_value.value_type == CfValueType::Formula {
+                rewrite_optional_reference(&mut min_value.value, old_name, new_name);
+            }
